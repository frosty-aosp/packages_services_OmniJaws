<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/weather_appwidget_bg"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/weather_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/widget_padding_small">

        <TextView
            android:id="@+id/clock_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:gravity="center"
            android:textAppearance="@style/WeatherLarge"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/current_weather_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/WeatherSmall" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/current_image"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/current_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textAppearance="@style/WeatherSmall"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/current_condition_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView android:id="@+id/current_wind_image"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/current_wind"
                android:layout_width="0dp" android:layout_height="0dp" />
            <ImageView android:id="@+id/current_wind_direction_image"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/current_wind_direction"
                android:layout_width="0dp" android:layout_height="0dp" />
            <ImageView android:id="@+id/current_humidity_image"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/current_humidity"
                android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/forecast_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView android:id="@+id/forecast_image_0"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_text_0"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_data_0"
                android:layout_width="0dp" android:layout_height="0dp" />

            <ImageView android:id="@+id/forecast_image_1"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_text_1"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_data_1"
                android:layout_width="0dp" android:layout_height="0dp" />

            <ImageView android:id="@+id/forecast_image_2"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_text_2"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_data_2"
                android:layout_width="0dp" android:layout_height="0dp" />

            <ImageView android:id="@+id/forecast_image_3"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_text_3"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_data_3"
                android:layout_width="0dp" android:layout_height="0dp" />

            <ImageView android:id="@+id/forecast_image_4"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_text_4"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/forecast_data_4"
                android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/current_weather_city"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/current_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/info_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textAppearance="@style/Weather" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>